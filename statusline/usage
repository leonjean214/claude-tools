CODEX_LOGS = HOME / ".codex" / "logs_2.sqlite"
USAGE_CACHE = HOME / ".cache" / "usage-costs.json"
MONTH_INDEX_CACHE = HOME / ".cache" / "usage-month-index.json"
COST_CACHE_TTL_SECONDS = 60

# 账单日可用同名的 USAGE_BILLING_DAY_* 环境变量覆盖。
BILLING_DAY_CLAUDE_DEFAULT = 4  # Claude 默认每月 4 日；来源：Gmail 收据。
BILLING_DAY_CODEX_DEFAULT = 3   # Codex 默认每月 3 日；来源：Gmail 收据。

WINDOWS = {
    "5h": dt.timedelta(hours=5),
    "7d": dt.timedelta(days=7),
}

# USD per 1M tokens. These are API-equivalent estimates, not subscription bills.
#
# OpenAI：以 pi 的模型注册表 ~/.pi/agent/models-store.json（openai-codex provider）为准，
# 运行时读取；读不到才用下面这份静态副本（2026-09-25 从同一文件抄出）。
# 超过 272K 输入 token 的请求整单按 tiers 价计。
PI_MODELS_STORE = HOME / ".pi" / "agent" / "models-store.json"
PI_SESSIONS = HOME / ".pi" / "agent" / "sessions"
OPENAI_TIER_THRESHOLD = 272_000
