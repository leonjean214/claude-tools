def default_openai_model() -> str:
    if os.environ.get("USAGE_CODEX_MODEL"):
        return os.environ["USAGE_CODEX_MODEL"]
    try:
        return codex_model()
    except Exception:  # 状态栏不能因模型文件/目录缺失而挂掉
        return OPENAI_PRICE_FALLBACK_MODEL

# Anthropic 一方 API 价（claude-api 技能价目表，2026-06-24 缓存）。按前缀最长优先匹配。
# cache write：5 分钟 TTL = 1.25× input，1 小时 TTL = 2× input。Claude Code 订阅会话的
# 缓存写入全是 1h（transcript 里 cache_creation.ephemeral_1h_input_tokens），旧版一律按
# 1.25× 算，系统性少算。
ANTHROPIC_PRICES = [
    ("claude-opus-5-5", {"input": 4.00, "output": 20.00, "cache_read": 0.20}),
    ("claude-fable-5-1", {"input": 10.00, "output": 50.00, "cache_read": 0.25}),
    ("claude-mythos-5-1", {"input": 10.00, "output": 50.00, "cache_read": 0.25}),
    ("claude-fable-5", {"input": 10.00, "output": 50.00, "cache_read": 1.00}),
    ("claude-mythos", {"input": 10.00, "output": 50.00, "cache_read": 1.00}),
    ("claude-opus", {"input": 5.00, "output": 25.00, "cache_read": 0.50}),       # opus-5 / 4.8 / 4.7 / 4.6
    ("claude-sonnet-5", {"input": 2.00, "output": 10.00, "cache_read": 0.20}),
    ("claude-sonnet", {"input": 3.00, "output": 15.00, "cache_read": 0.30}),
    ("claude-haiku", {"input": 1.00, "output": 5.00, "cache_read": 0.10}),
]
ANTHROPIC_WRITE_5M = 1.25
ANTHROPIC_WRITE_1H = 2.0


@dataclass
class WindowStatus:
    used_pct: float | None = None
    reset_at: dt.datetime | None = None


@dataclass
class UsageCost:
    five_hour: float = 0.0
    seven_day: float = 0.0
    estimated: bool = False
    month: float = 0.0


def cost_to_dict(cost: UsageCost) -> dict[str, Any]:
    return {
        "five_hour": cost.five_hour,
        "seven_day": cost.seven_day,
        "month": cost.month,
        "estimated": cost.estimated,
    }


def cost_from_dict(value: Any) -> UsageCost | None:
    if not isinstance(value, dict):
        return None
    try:
        return UsageCost(
            five_hour=float(value.get("five_hour", 0)),
            seven_day=float(value.get("seven_day", 0)),
            month=float(value.get("month", 0)),
            estimated=bool(value.get("estimated", False)),
        )
    except Exception:
        return None


def load_cost_cache() -> dict[str, UsageCost] | None:
    data = load_json(USAGE_CACHE)
    if not data:
        return None
    written_at = parse_time(data.get("written_at"))
    if written_at is None:
        return None
    now = now_local()
    if (now - written_at).total_seconds() > COST_CACHE_TTL_SECONDS:
        return None
    cycles = data.get("cycles")
    # Pre-cycle caches cannot identify which service period their old `month`
    # value belongs to, so force one rebuild. Missing per-service month fields
    # remain compatible once the cache carries valid cycle keys.
    if not isinstance(cycles, dict) or cycles != billing_cycle_keys(now):
        return None
    claude = cost_from_dict(data.get("claude"))
    codex = cost_from_dict(data.get("codex"))
    if claude is None or codex is None:
        return None
    return {"claude": claude, "codex": codex}


def write_cost_cache(claude: UsageCost, codex: UsageCost) -> None:
    try:
        now = now_local()
        USAGE_CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = USAGE_CACHE.with_suffix(".tmp")
        tmp.write_text(
            json.dumps(
                {
                    "written_at": now.isoformat(timespec="seconds"),
                    "cycles": billing_cycle_keys(now),
                    "claude": cost_to_dict(claude),
                    "codex": cost_to_dict(codex),
                },
                ensure_ascii=False,
                indent=2,
            )
            + "\n"
        )
        os.replace(tmp, USAGE_CACHE)
    except OSError:
        pass


def now_local() -> dt.datetime:
    return dt.datetime.now().astimezone()


def configured_billing_day(env_name: str, default: int) -> int:
    try:
        return max(1, min(31, int(os.environ.get(env_name, default))))
    except (TypeError, ValueError):
        return default


def _month_anchor(now: dt.datetime, year: int, month: int, billing_day: int) -> dt.datetime:
    if month == 12:
        next_month = now.replace(year=year + 1, month=1, day=1)
    else:
        next_month = now.replace(year=year, month=month + 1, day=1)
    last_day = (next_month - dt.timedelta(days=1)).day
    return now.replace(
        year=year, month=month, day=min(billing_day, last_day),
        hour=0, minute=0, second=0, microsecond=0,
    )


def billing_cycle(now: dt.datetime, billing_day: int) -> tuple[dt.datetime, dt.datetime]:
    """Return the current billing cycle's local-time [start, end) boundaries."""
    this_anchor = _month_anchor(now, now.year, now.month, billing_day)
    if now >= this_anchor:
        start = this_anchor
        next_year, next_month = (now.year + 1, 1) if now.month == 12 else (now.year, now.month + 1)
        end = _month_anchor(now, next_year, next_month, billing_day)
    else:
        end = this_anchor
        prev_year, prev_month = (now.year - 1, 12) if now.month == 1 else (now.year, now.month - 1)
        start = _month_anchor(now, prev_year, prev_month, billing_day)
    return start, end


def claude_cycle(now: dt.datetime) -> tuple[dt.datetime, dt.datetime]:
    day = configured_billing_day("USAGE_BILLING_DAY_CLAUDE", BILLING_DAY_CLAUDE_DEFAULT)
    return billing_cycle(now, day)


def codex_cycle(now: dt.datetime) -> tuple[dt.datetime, dt.datetime]:
    day = configured_billing_day("USAGE_BILLING_DAY_CODEX", BILLING_DAY_CODEX_DEFAULT)
    return billing_cycle(now, day)


def billing_cycle_keys(now: dt.datetime) -> dict[str, str]:
    return {
        "claude": claude_cycle(now)[0].isoformat(),
        "codex": codex_cycle(now)[0].isoformat(),
    }


def scan_start(now: dt.datetime, cycle_start: dt.datetime) -> dt.datetime:
    """Earliest timestamp needed by either the 7d or billing-cycle window."""
    return min(now - WINDOWS["7d"], cycle_start)


def load_month_index() -> dict[str, Any]:
    data = load_json(MONTH_INDEX_CACHE)
    if not isinstance(data, dict) or data.get("version") != 2:
        return {"version": 2, "cycles": {}, "files": {}}
    if not isinstance(data.get("files"), dict):
        data["files"] = {}
    if not isinstance(data.get("cycles"), dict):
        data["cycles"] = {}
    return data


def prepare_cycle_index(
    index: dict[str, Any], namespace: str, cycle_start: dt.datetime
) -> None:
    cycle_key = cycle_start.isoformat()
    if index["cycles"].get(namespace) == cycle_key:
        return
    prefix = f"{namespace}:"
    for key in list(index["files"]):
        if key.startswith(prefix):
            del index["files"][key]
    index["cycles"][namespace] = cycle_key


def write_month_index(index: dict[str, Any]) -> None:
    """Atomically save parsed per-file records; a changed size/mtime reparses the file."""
    try:
        MONTH_INDEX_CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = MONTH_INDEX_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(index, ensure_ascii=False, separators=(",", ":")) + "\n")
        os.replace(tmp, MONTH_INDEX_CACHE)
    except OSError:
        pass


def indexed_records(
    index: dict[str, Any], namespace: str, path: Path,
    cycle_start: dt.datetime, parser: Any,
) -> list[list[Any]]:
    """Return cached parsed records when the file identity is unchanged."""
    try:
        before = path.stat()
    except OSError:
        return []
    cache_key = f"{namespace}:{path}"
    files = index["files"]
    cached = files.get(cache_key)
    if (
        isinstance(cached, dict)
        and cached.get("mtime_ns") == before.st_mtime_ns
        and cached.get("size") == before.st_size
        and isinstance(cached.get("records"), list)
    ):
        return cached["records"]
    try:
        records = parser(path)
    except OSError:
        return []
    try:
        after = path.stat()
    except OSError:
        return records
    # Do not cache a partial view if a live transcript changed while being read.
    if (before.st_mtime_ns, before.st_size) == (after.st_mtime_ns, after.st_size):
        files[cache_key] = {
            "mtime_ns": after.st_mtime_ns,
            "size": after.st_size,
            "period_cost": sum(
                float(record[1]) for record in records
                if float(record[0]) >= cycle_start.timestamp()
            ),
            "records": records,
        }
    return records


def prune_month_index(index: dict[str, Any], namespace: str, seen_paths: set[str]) -> None:
    prefix = f"{namespace}:"
    for key in list(index["files"]):
        if key.startswith(prefix) and key[len(prefix):] not in seen_paths:
            del index["files"][key]


def parse_time(value: Any) -> dt.datetime | None:
    if value is None:
        return None
    try:
        if isinstance(value, (int, float)):
            return dt.datetime.fromtimestamp(value, tz=dt.timezone.utc).astimezone()
        text = str(value)
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        parsed = dt.datetime.fromisoformat(text)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed.astimezone()
    except Exception:
        return None


def load_json(path: Path) -> dict[str, Any] | None:
    try:
        return json.loads(path.read_text())
    except Exception:
        return None


def bar(percent: float | None, width: int = 10) -> str:
    if percent is None:
        return "?" * width
    filled = max(0, min(width, int(round(percent / 100 * width))))
    return "█" * filled + "░" * (width - filled)


def fmt_pct(percent: float | None) -> str:
    return "??%" if percent is None else f"{percent:.0f}%"


def fmt_reset(reset_at: dt.datetime | None) -> str:
    if reset_at is None:
        return "未知"
    now = now_local()
    minutes = int((reset_at - now).total_seconds() / 60)
    if reset_at.date() == now.date():
        base = reset_at.strftime("%H:%M")
    else:
        base = reset_at.strftime("%m/%d %H:%M")
    if minutes <= 0:
        return f"{base}(已过)"
    if minutes < 60:
        return f"{base}({minutes}m后)"
    if minutes < 24 * 60:
        return f"{base}({minutes // 60}h{minutes % 60:02d}m后)"
    return f"{base}({minutes // 1440}d后)"


def fmt_cost(value: float) -> str:
    if value < 0.005:
        return "~$0.00"
    if value < 1:
        return f"~${value:.2f}"
    return f"~${value:.2f}"


def fallback_status(command: list[str], parser: str) -> dict[str, WindowStatus]:
    try:
        proc = subprocess.run(command, capture_output=True, text=True, timeout=20, check=False)
    except Exception:
        return {"5h": WindowStatus(), "7d": WindowStatus()}
    out = {"5h": WindowStatus(), "7d": WindowStatus()}
    for line in proc.stdout.splitlines():
        if parser == "claude":
            match = re.search(r"^(5h|7d)\s+\[[^\]]+\]\s+(\d+(?:\.\d+)?)%", line)
        else:
            match = re.search(r"^(5h|7d):\s+已使用\s+(\d+(?:\.\d+)?)%", line)
        if match:
            out[match.group(1)].used_pct = float(match.group(2))
    return out


def claude_status() -> dict[str, WindowStatus]:
    data = load_json(CLAUDE_STATUS)
    if not data:
        return fallback_status([str(HOME / "bin" / "quota-wait"), "--status"], "claude")

    limits = data.get("rate_limits") or {}
    return {
        "5h": WindowStatus(
            used_pct=_num((limits.get("five_hour") or {}).get("used_percentage")),
            reset_at=parse_time((limits.get("five_hour") or {}).get("resets_at")),
        ),
        "7d": WindowStatus(
            used_pct=_num((limits.get("seven_day") or {}).get("used_percentage")),
            reset_at=parse_time((limits.get("seven_day") or {}).get("resets_at")),
        ),
    }


def codex_status() -> dict[str, WindowStatus]:
    data = load_json(CODEX_STATUS)
    if not data:
        return fallback_status([str(HOME / "bin" / "codex-quota-watch"), "--status"], "codex")

    primary = data.get("primary") or {}
    weekly = data.get("weekly") or {}
    return {
        "5h": WindowStatus(_num(primary.get("usedPercent")), parse_time(primary.get("resetsAt"))),
        "7d": WindowStatus(_num(weekly.get("usedPercent")), parse_time(weekly.get("resetsAt"))),
    }


def _num(value: Any) -> float | None:
    try:
        return float(value)
    except Exception:
        return None


def anthropic_price_for(model: str) -> dict[str, float]:
    model = (model or "").lower()
    for prefix, price in ANTHROPIC_PRICES:
        if model.startswith(prefix):
            return price
    return dict(ANTHROPIC_PRICES)["claude-opus"]


_openai_prices: dict[str, dict[str, Any]] | None = None


def openai_prices() -> dict[str, dict[str, Any]]:
    """pi 注册表里 openai-codex 的价格；失败退回静态副本。"""
    global _openai_prices
    if _openai_prices is not None:
        return _openai_prices
    prices: dict[str, dict[str, Any]] = {}
    data = load_json(PI_MODELS_STORE)

    def walk(o: Any) -> None:
        if isinstance(o, dict):
            cost = o.get("cost")
            mid = o.get("id")
            if isinstance(cost, dict) and isinstance(mid, str) and mid.startswith("gpt"):
                entry = {k: float(cost.get(k) or 0) for k in ("input", "output", "cacheRead", "cacheWrite")}
                for tier in cost.get("tiers") or []:
                    if tier.get("inputTokensAbove") == OPENAI_TIER_THRESHOLD:
                        entry["tier"] = {k: float(tier.get(k) or 0)
                                         for k in ("input", "output", "cacheRead", "cacheWrite")}
                prices.setdefault(mid, entry)
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    if data:
        walk(data)
    _openai_prices = {**OPENAI_PRICES_FALLBACK, **prices}
    return _openai_prices


def openai_price_for(model: str, prompt_tokens: float = 0) -> dict[str, float]:
    table = openai_prices()
    model = (model or "").lower()
    price = table.get(model)
    if price is None:
        # 最长前缀优先：旧版按插入顺序 `in` 匹配，gpt-5.4-mini 会先撞上 gpt-5.4
        for key in sorted(table, key=len, reverse=True):
            if model.startswith(key):
                price = table[key]
                break
    price = price or table[OPENAI_PRICE_FALLBACK_MODEL]
    if prompt_tokens > OPENAI_TIER_THRESHOLD and "tier" in price:
        return price["tier"]
    return price


def openai_cost(model: str, uncached: float, cache_read: float, cache_write: float,
                output: float) -> float:
    p = openai_price_for(model, uncached + cache_read + cache_write)
    return (uncached * p["input"] + cache_read * p["cacheRead"]
            + cache_write * p["cacheWrite"] + output * p["output"]) / 1_000_000


def claude_entry_cost(model: str, usage: dict[str, Any]) -> float:
    p = anthropic_price_for(model)
    input_tokens = _num(usage.get("input_tokens")) or 0
    output_tokens = _num(usage.get("output_tokens")) or 0
    cache_read = _num(usage.get("cache_read_input_tokens")) or 0
    breakdown = usage.get("cache_creation")
    if isinstance(breakdown, dict):
        write_1h = _num(breakdown.get("ephemeral_1h_input_tokens")) or 0
        write_5m = _num(breakdown.get("ephemeral_5m_input_tokens")) or 0
    else:
        write_1h, write_5m = 0, _num(usage.get("cache_creation_input_tokens")) or 0
    return (
        input_tokens * p["input"]
        + write_5m * p["input"] * ANTHROPIC_WRITE_5M
        + write_1h * p["input"] * ANTHROPIC_WRITE_1H
        + cache_read * p["cache_read"]
        + output_tokens * p["output"]
    ) / 1_000_000


def claude_costs() -> UsageCost:
    now = now_local()
    cutoffs = {name: now - delta for name, delta in WINDOWS.items()}
    cycle_start, _ = claude_cycle(now)
    start = scan_start(now, cycle_start)
    index = load_month_index()
    prepare_cycle_index(index, "claude", cycle_start)
    records: list[list[Any]] = []
    seen_paths: set[str] = set()

    if not CLAUDE_PROJECTS.exists():
        return UsageCost()

    pattern = str(CLAUDE_PROJECTS / "**" / "*.jsonl")
    for filename in glob.iglob(pattern, recursive=True):
        path = Path(filename)
        seen_paths.add(str(path))
        try:
            if dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc).astimezone() < start:
                continue
        except OSError:
            continue

        def parse_file(source: Path) -> list[list[Any]]:
            parsed: list[list[Any]] = []
            try:
                fh = source.open()
            except OSError:
                return parsed
            with fh:
                for line in fh:
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    timestamp = parse_time(item.get("timestamp"))
                    if timestamp is None or timestamp < start:
                        continue
                    msg = item.get("message") or {}
                    usage = msg.get("usage")
                    if not isinstance(usage, dict):
                        continue
                    model = str(msg.get("model") or item.get("model") or "")
                    key = item.get("requestId") or msg.get("id") or item.get("uuid")
                    parsed.append([
                        timestamp.timestamp(),
                        claude_entry_cost(model, usage),
                        json.dumps(key, sort_keys=True) if key else None,
                        _num(usage.get("output_tokens")) or 0,
                    ])
            return parsed

        records.extend(indexed_records(index, "claude", path, cycle_start, parse_file))

    prune_month_index(index, "claude", seen_paths)
    write_month_index(index)

    def total_since(cutoff: dt.datetime) -> tuple[float, list[list[Any]]]:
        anonymous: list[list[Any]] = []
        best: dict[str, list[Any]] = {}
        for record in records:
            if float(record[0]) < cutoff.timestamp():
                continue
            key = record[2]
            if key is None:
                anonymous.append(record)
            elif key not in best or float(record[3]) > float(best[key][3]):
                # 流式记录取 output_tokens 最大者；fork 副本仍只算一次。
                best[key] = record
        chosen = anonymous + list(best.values())
        return sum(float(record[1]) for record in chosen), chosen

    seven, seven_records = total_since(cutoffs["7d"])
    five = sum(float(record[1]) for record in seven_records if float(record[0]) >= cutoffs["5h"].timestamp())
    month, _ = total_since(cycle_start)
    return UsageCost(five, seven, month=month)


def extract_json_event(body: str) -> dict[str, Any] | None:
    marker = "websocket event: "
    idx = body.find(marker)
    if idx >= 0:
        text = body[idx + len(marker) :]
    else:
        marker = "Received message "
        idx = body.find(marker)
        if idx < 0:
            return None
        text = body[idx + len(marker) :]
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        decoder = json.JSONDecoder()
        try:
            obj, _ = decoder.raw_decode(text)
            return obj
        except json.JSONDecodeError:
            return None


def codex_completion_cost(model: str, usage: dict[str, Any]) -> float:
    input_tokens = _num(usage.get("input_tokens")) or 0
    cached_tokens = _num(usage.get("cached_input_tokens")) or 0
    output_tokens = _num(usage.get("output_tokens")) or 0
    return openai_cost(model, max(0.0, input_tokens - cached_tokens), cached_tokens, 0, output_tokens)


def codex_costs_from_completions(now: dt.datetime) -> UsageCost | None:
    if not CODEX_LOGS.exists():
        return None
    cutoff7 = int((now - WINDOWS["7d"]).timestamp())
    cycle_start, _ = codex_cycle(now)
    cutoff = int(scan_start(now, cycle_start).timestamp())
    totals = {"5h": 0.0, "7d": 0.0, "month": 0.0}
    seen7: set[Any] = set()
    seen_month: set[Any] = set()

    query = """
        SELECT ts, feedback_log_body
        FROM logs
        WHERE ts >= ?
          AND feedback_log_body LIKE '%"type":"response.completed"%'
          AND feedback_log_body LIKE '%"usage"%'
        ORDER BY ts ASC
    """
    try:
        conn = sqlite3.connect(f"file:{CODEX_LOGS}?mode=ro", uri=True)
        try:
            rows = conn.execute(query, (cutoff,))
            for ts, body in rows:
                event = extract_json_event(body or "")
                if not event or event.get("type") != "response.completed":
                    continue
                response = event.get("response") or {}
                usage = response.get("usage")
                if not isinstance(usage, dict):
                    continue
                if usage.get("output_tokens") == 0 and response.get("generate") is False:
                    continue
                model = response.get("model") or _model_from_log(body or "") or "gpt-5.5"
                cost = codex_completion_cost(str(model), usage)
                when = dt.datetime.fromtimestamp(int(ts), tz=dt.timezone.utc).astimezone()
                response_id = response.get("id")
                if when >= cycle_start and response_id not in seen_month:
                    # Match the historical behavior exactly, including id=None.
                    seen_month.add(str(response_id))
                    totals["month"] += cost
                # Keep the old 7d query/dedupe boundary independent of the wider scan.
                if int(ts) >= cutoff7 and response_id not in seen7:
                    seen7.add(str(response_id))
                    totals["7d"] += cost
                    if when >= now - WINDOWS["5h"]:
                        totals["5h"] += cost
        finally:
            conn.close()
    except sqlite3.Error:
        return None

    return UsageCost(totals["5h"], totals["7d"], month=totals["month"])


def _model_from_log(body: str) -> str | None:
    match = re.search(r"model=([A-Za-z0-9_.-]+)", body)
    return match.group(1) if match else None


def codex_costs_from_token_deltas(now: dt.datetime) -> UsageCost:
    """Fallback for older logs: total_usage_tokens is cumulative per turn."""
    if not CODEX_LOGS.exists():
        return UsageCost(estimated=True)

    cutoff7 = int((now - WINDOWS["7d"]).timestamp())
    cycle_start, _ = codex_cycle(now)
    cutoff = int(scan_start(now, cycle_start).timestamp())
    by_turn: dict[str, list[tuple[int, int, str]]] = {}
    pattern = re.compile(
        r"turn_id=([A-Za-z0-9-]+).*?model=([A-Za-z0-9_.-]+).*?"
        r"total_usage_tokens=(\d+)"
    )
    query = """
        SELECT ts, feedback_log_body
        FROM logs
        WHERE ts >= ?
          AND feedback_log_body LIKE '%post sampling token usage%'
        ORDER BY ts ASC
    """
    try:
        conn = sqlite3.connect(f"file:{CODEX_LOGS}?mode=ro", uri=True)
        try:
            for ts, body in conn.execute(query, (cutoff,)):
                match = pattern.search(body or "")
                if not match:
                    continue
                turn_id, model, total = match.group(1), match.group(2), int(match.group(3))
                by_turn.setdefault(turn_id, []).append((int(ts), total, model))
        finally:
            conn.close()
    except sqlite3.Error:
        return UsageCost(estimated=True)

    def total_from(minimum: int, include_five: bool = False) -> tuple[float, float]:
        window_total = 0.0
        five_total = 0.0
        for samples in by_turn.values():
            selected = [sample for sample in samples if sample[0] >= minimum]
            selected.sort()
            previous = 0
            for ts, total, model in selected:
                delta = max(0, total - previous)
                previous = max(previous, total)
                # Conservative fallback: treat delta as uncached input when no split is available.
                cost = delta * openai_price_for(model)["input"] / 1_000_000
                window_total += cost
                if include_five:
                    when = dt.datetime.fromtimestamp(ts, tz=dt.timezone.utc).astimezone()
                    if when >= now - WINDOWS["5h"]:
                        five_total += cost
        return window_total, five_total

    seven, five = total_from(cutoff7, include_five=True)
    month, _ = total_from(int(cycle_start.timestamp()))
    return UsageCost(five, seven, estimated=True, month=month)


CODEX_SESSIONS = HOME / ".codex" / "sessions"


def codex_costs_from_sessions(now: dt.datetime) -> UsageCost | None:
    """Codex CLI >= 0.39 writes per-turn token usage to session rollout files
    (~/.codex/sessions/**/rollout-*.jsonl) as event_msg/token_count events,
    not to logs_2.sqlite anymore. info.last_token_usage is per-turn incremental."""
    if not CODEX_SESSIONS.exists():
        return None

    cutoff5 = now - WINDOWS["5h"]
    cutoff7 = now - WINDOWS["7d"]
    cycle_start, _ = codex_cycle(now)
    start = scan_start(now, cycle_start)
    index = load_month_index()
    prepare_cycle_index(index, "codex", cycle_start)
    records: list[list[Any]] = []
    seen_paths: set[str] = set()

    pattern = str(CODEX_SESSIONS / "**" / "rollout-*.jsonl")
    for filename in glob.iglob(pattern, recursive=True):
        path = Path(filename)
        seen_paths.add(str(path))
        try:
            mtime = dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc).astimezone()
            if mtime < start:
                continue
        except OSError:
            continue

        def parse_file(source: Path) -> list[list[Any]]:
            parsed: list[list[Any]] = []
            model = default_openai_model()
            try:
                fh = source.open()
            except OSError:
                return parsed
            with fh:
                for line in fh:
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    itype = item.get("type")
                    payload = item.get("payload")
                    if not isinstance(payload, dict):
                        continue
                    if itype == "turn_context":
                        model = payload.get("model") or model
                        continue
                    if itype == "session_meta":
                        model = payload.get("model") or model
                        continue
                    if itype != "event_msg" or payload.get("type") != "token_count":
                        continue
                    when = parse_time(item.get("timestamp"))
                    if when is None or when < start:
                        continue
                    usage = (payload.get("info") or {}).get("last_token_usage")
                    if not isinstance(usage, dict):
                        continue
                    cost = codex_session_turn_cost(model, usage)
                    parsed.append([when.timestamp(), cost])
            return parsed

        records.extend(indexed_records(index, "codex", path, cycle_start, parse_file))

    prune_month_index(index, "codex", seen_paths)
    write_month_index(index)
    if not records:
        return None
    seven_records = [record for record in records if float(record[0]) >= cutoff7.timestamp()]
    return UsageCost(
        sum(float(record[1]) for record in seven_records if float(record[0]) >= cutoff5.timestamp()),
        sum(float(record[1]) for record in seven_records),
        month=sum(float(record[1]) for record in records if float(record[0]) >= cycle_start.timestamp()),
    )


def codex_session_turn_cost(model: str, usage: dict[str, Any]) -> float:
    # OpenAI 口径：input_tokens 含缓存命中与缓存写入；output_tokens 已含 reasoning
    input_tokens = _num(usage.get("input_tokens")) or 0
    cached_tokens = _num(usage.get("cached_input_tokens")) or 0
    cache_write = _num(usage.get("cache_write_input_tokens")) or 0
    output_tokens = _num(usage.get("output_tokens")) or 0
    uncached = max(0.0, input_tokens - cached_tokens - cache_write)
    return openai_cost(model, uncached, cached_tokens, cache_write, output_tokens)


def pi_codex_costs(now: dt.datetime) -> UsageCost:
    """pi 走 Codex 订阅（openai-codex provider）的用量 —— 不经过 codex CLI，
    旧版完全没统计，而 pi / pi-flow 恰恰是烧 Codex 的主力。pi-flow 派生的
    executor/reviewer 子进程消息也落在同一批会话文件里。
    pi 的 usage.input 已扣掉 cacheRead/cacheWrite（与它自己的 cost 计算口径一致）。"""
    cutoff5 = now - WINDOWS["5h"]
    cutoff7 = now - WINDOWS["7d"]
    cycle_start, _ = codex_cycle(now)
    start = scan_start(now, cycle_start)
    index = load_month_index()
    prepare_cycle_index(index, "pi", cycle_start)
    records: list[list[Any]] = []
    seen_paths: set[str] = set()
    if not PI_SESSIONS.exists():
        return UsageCost()
    for filename in glob.iglob(str(PI_SESSIONS / "**" / "*.jsonl"), recursive=True):
        path = Path(filename)
        seen_paths.add(str(path))
        try:
            if dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc).astimezone() < start:
                continue
        except OSError:
            continue

        def parse_file(source: Path) -> list[list[Any]]:
            parsed: list[list[Any]] = []
            try:
                fh = source.open(errors="replace")
            except OSError:
                return parsed
            with fh:
                for line in fh:
                    if '"openai-codex"' not in line or '"usage"' not in line:
                        continue
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    msg = item.get("message") or {}
                    usage = msg.get("usage")
                    if msg.get("provider") != "openai-codex" or not isinstance(usage, dict):
                        continue
                    when = parse_time(item.get("timestamp"))
                    if when is None and isinstance(msg.get("timestamp"), (int, float)):
                        when = dt.datetime.fromtimestamp(msg["timestamp"] / 1000, tz=dt.timezone.utc).astimezone()
                    if when is None or when < start:
                        continue
                    key = msg.get("responseId") or (
                        (item.get("id"), msg.get("timestamp")) if item.get("id") else None)
                    cost = openai_cost(
                        str(msg.get("model") or default_openai_model()),
                        _num(usage.get("input")) or 0,
                        _num(usage.get("cacheRead")) or 0,
                        _num(usage.get("cacheWrite")) or 0,
                        _num(usage.get("output")) or 0,
                    )
                    parsed.append([
                        when.timestamp(),
                        cost,
                        json.dumps(key, sort_keys=True) if key is not None else None,
                    ])
            return parsed

        records.extend(indexed_records(index, "pi", path, cycle_start, parse_file))

    prune_month_index(index, "pi", seen_paths)
    write_month_index(index)

    def chosen_since(cutoff: dt.datetime) -> list[list[Any]]:
        chosen: list[list[Any]] = []
        seen: set[str] = set()
        for record in records:
            if float(record[0]) < cutoff.timestamp():
                continue
            key = record[2]
            if key is not None:
                if key in seen:
                    continue
                seen.add(key)
            chosen.append(record)
        return chosen

    seven_records = chosen_since(cutoff7)
    month_records = chosen_since(cycle_start)
    return UsageCost(
        sum(float(record[1]) for record in seven_records if float(record[0]) >= cutoff5.timestamp()),
        sum(float(record[1]) for record in seven_records),
        month=sum(float(record[1]) for record in month_records),
    )


def codex_costs() -> UsageCost:
    now = now_local()
    cli = codex_costs_from_sessions(now)
    month = cli.month if cli is not None else 0.0
    if cli is None or (cli.five_hour == 0 and cli.seven_day == 0):
        candidate = codex_costs_from_completions(now)
        if candidate is not None:
            month = max(month, candidate.month)
        cli = candidate
    if cli is None or (cli.five_hour == 0 and cli.seven_day == 0):
        candidate = codex_costs_from_token_deltas(now)
        month = max(month, candidate.month)
        cli = candidate
    # The three CLI sources are generations/fallbacks of the same events, so do
    # not add them together. Retain the broadest monthly result seen while the
    # 5h/7d source-selection behavior remains exactly as before.
    cli.month = month
    pi = pi_codex_costs(now)
    return UsageCost(
        cli.five_hour + pi.five_hour,
        cli.seven_day + pi.seven_day,
        estimated=cli.estimated,
        month=cli.month + pi.month,
    )


def print_service(
    name: str,
    status: dict[str, WindowStatus],
    costs: UsageCost,
    cycle: tuple[dt.datetime, dt.datetime],
) -> None:
    s5 = status.get("5h") or WindowStatus()
    s7 = status.get("7d") or WindowStatus()
    print(
        f"{name:<7} 5h [{bar(s5.used_pct)}] {fmt_pct(s5.used_pct):>4} reset {fmt_reset(s5.reset_at):<16} "
        f"7d [{bar(s7.used_pct)}] {fmt_pct(s7.used_pct):>4} reset {fmt_reset(s7.reset_at)}"
    )
    note = " 估算" if costs.estimated else ""
    cycle_text = f"本期 {cycle[0]:%m-%d} → {cycle[1]:%m-%d}"
    print(
        f"{'':<7} cost  5h {fmt_cost(costs.five_hour):>8}    "
        f"7d {fmt_cost(costs.seven_day):>8}    mo {fmt_cost(costs.month):>8}{note}  {cycle_text}"
    )


def main() -> int:
    display_now = now_local()
    cached_costs = load_cost_cache()
    if cached_costs is None:
        claude_cost = claude_costs()
        codex_cost = codex_costs()
        write_cost_cache(claude_cost, codex_cost)
    else:
        claude_cost = cached_costs["claude"]
        codex_cost = cached_costs["codex"]

    print(f"=== 用量总览  [{display_now.strftime('%H:%M:%S')}] ===")
    print_service("Claude", claude_status(), claude_cost, claude_cycle(display_now))
    print_service("Codex", codex_status(), codex_cost, codex_cycle(display_now))
    total5 = claude_cost.five_hour + codex_cost.five_hour
    total7 = claude_cost.seven_day + codex_cost.seven_day
    total_month = claude_cost.month + codex_cost.month
    total_note = " 估算" if (claude_cost.estimated or codex_cost.estimated) else ""
    print(
        f"{'Total':<7} cost  5h {fmt_cost(total5):>8}    "
        f"7d {fmt_cost(total7):>8}    mo {fmt_cost(total_month):>8}{total_note}"
    )
    print("cost 为等价 API 定价估算（Codex 含 codex CLI + pi），非 ChatGPT/Claude 订阅真实账单。")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
